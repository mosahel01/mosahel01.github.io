---
import { projects, profile } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="projects" class="w-full py-8">
  <div class="mb-4 flex flex-col items-center gap-1 text-center">
    <h2 class="showcase-heading">My Projects</h2>
  </div>

  <div class="mx-auto grid max-w-[800px] gap-4 px-6">
    {
      projects.map((project, i) => (
        <article
          class="project-card reveal"
          style={`transition-delay:${80 + i * 60}ms`}
        >
          <h3 class="text-xl font-semibold tracking-tight">{project.title}</h3>
          <p class="text-pretty text-sm">
            {project.description}
          </p>
          <div class="my-4 flex flex-wrap gap-2">
            {
              project.stack.map((tech) => (
                <span class="chip-project">{tech}</span>
              ))
            }
          </div>
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary mr-2 w-fit"
          >
            <Icon name="github" size={16} />
            GitHub
          </a>
        </article>
      ))
    }
  </div>

  <div class="mt-5 flex flex-col items-center justify-center gap-2 text-center">
    <a href={profile.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
      View all projects on GitHub
    </a>
  </div>
</section>