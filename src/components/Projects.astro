---
import { projects, profile } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="projects" class="w-full py-8">
  <div class="mb-4 flex flex-col items-center gap-1 text-center">
    <h2 class="showcase-heading">My Projects</h2>
  </div>

  <div class="mx-auto grid max-w-[800px] gap-3 px-6">
    {
      projects.map((project, i) => (
        <article
          class="project-card reveal"
          style={`transition-delay:${80 + i * 60}ms`}
        >
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-xl font-semibold tracking-tight">{project.title}</h3>
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View the source of ${project.title} on GitHub`}
              class="mt-1 text-muted-foreground transition-colors hover:text-foreground"
            >
              <Icon name="github" size={18} />
            </a>
          </div>
          <p class="text-pretty text-sm">
            {project.description}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              project.stack.map((tech) => (
                <span class="chip-project">{tech}</span>
              ))
            }
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-5 flex flex-col items-center justify-center gap-2 text-center">
    <a href={https://github.com/mosahel01?tab=repositories} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
      View all projects on GitHub
    </a>
  </div>
</section>
