---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="hero" class="reveal mx-auto w-full max-w-2xl space-y-8">
  <div class="flex items-center justify-between gap-2">
    <div class="flex-1 space-y-1.5">
      <h1 class="text-3xl font-bold leading-none tracking-tighter sm:text-5xl xl:text-6xl">
        Hi, I'm {profile.firstName} 👋
      </h1>
      <span class="max-w-[600px] pt-1 text-base md:text-xl">
        <!-- I'm a {profile.role.toLowerCase()} in {profile.location}. {profile.tagline} -->
        I'm a {profile.role.toLowerCase()}. {profile.tagline}
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 inline-flex items-center gap-1 text-muted-foreground underline transition-colors hover:text-foreground"
        >
          Check out my GitHub
          <Icon name="arrow-right" size={16} />
        </a>
      </span>
    </div>
    <span class="avatar avatar-hero">
      <img
        src="/profile.jpg"
        alt={`Portrait of ${profile.name}`}
        width="1024"
        height="1024"
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </span>
  </div>
</section>
