---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="contact" class="grid w-full items-center justify-center gap-2 px-6 text-center">
  <h2 class="showcase-heading">Get in Touch</h2>
  <!-- <p class="max-w-lg text-sm"> -->
  <!--   Contact me at -->
  <!--   <a href={`mailto:${profile.email}`} class="underline" >{profile.email}</a> -->
    <!-- or through this form. -->
  <!-- </p> -->

  <form
    id="contact-form"
    data-recipient={profile.email}
    class="mt-4 flex w-[min(100%,38rem)] flex-col"
  >
    <input
      type="email"
      name="email"
      placeholder="Your email"
      required
      class="field"
    />
    <textarea
      name="message"
      placeholder="Your message"
      required
      class="field field-textarea"
    ></textarea>
    <button type="submit" class="submit-btn">
      Submit
      <Icon name="send" size={12} iconClass="opacity-70 group-hover:translate-x-1 group-hover:-translate-y-1" />
    </button>
  </form>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const recipient = form.dataset.recipient;
    if (!recipient) return;
    const fd = new FormData(form);
    const email = String(fd.get('email') || '');
    const message = String(fd.get('message') || '');
    const subject = encodeURIComponent('Contact from portfolio');
    const body = encodeURIComponent(`Sent from: ${email}\n\n${message}`);
    window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
  });
</script>
